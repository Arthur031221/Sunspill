{
  "name": "sunspill",
  "version": "0.2.2",
  "description": "Set up your own room on a phone, then see where the sun lands on its floor by the hour and the season. Buildings and trees from OpenStreetMap, a check against the real sun. Your room stays in the browser.",
  "type": "module",
  "files": [
    "dist/sunspill.js",
    "docs"
  ],
  "exports": {
    ".": "./dist/sunspill.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=120000 test/e2e/*.e2e.js",
    "reference": "python3 scripts/make-reference.py",
    "assets": "node scripts/make-assets.mjs",
    "icons": "node scripts/make-icons.mjs",
    "demo": "node scripts/record-demo.mjs",
    "demo:setup": "node scripts/record-setup-demo.mjs",
    "validate": "node scripts/validate.mjs",
    "sensitivity": "node scripts/sensitivity.mjs"
  },
  "author": "Arthur031221",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arthur031221/Sunspill.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.2.0",
    "@photostructure/tz-lookup": "^11.7.0",
    "esbuild": "^0.28.2",
    "playwright": "1.63.0"
  },
  "private": true,
  "keywords": [
    "sunlight",
    "sun-position",
    "shadow",
    "interior-design",
    "openstreetmap",
    "floor-plan",
    "pwa",
    "solar"
  ]
}
